# Optional local configuration. Copy to .env and adjust as needed.
CLOUDPOINT_DB_PATH=instance/cloudpoint.sqlite3
CLOUDPOINT_HOST=127.0.0.1
CLOUDPOINT_PORT=8000

# Required for administrator HMAC-signed sessions. Generate a random value of at least 32 characters.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUDPOINT_SESSION_SECRET=

# Optional for the Lambda/DynamoDB adapter; local SQLite does not use these.
# CLOUDPOINT_DYNAMODB_TABLE=cloudpoint-complaints
# CLOUDPOINT_AWS_REGION=us-east-1
